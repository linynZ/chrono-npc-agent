# Copy this file to `.env` and fill in your key. `.env` is gitignored.
#
#   cp .env.example .env      (Git Bash)
#   copy .env.example .env    (cmd)

# --- DeepSeek (cloud backend) ---
# Get one at https://platform.deepseek.com/api_keys — shown only once, copy it immediately.
DEEPSEEK_API_KEY=

# Cheap + fast, supports tool calls. Alternative: deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Ollama (local backend, phase 2) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Which backend to use by default: deepseek | ollama | echo
# `echo` is a fake provider that needs no key — used by the test suite.
AGENT_PROVIDER=deepseek

# Latency budget in milliseconds. Exceeding it triggers fallback to pre-written lines.
AGENT_TIMEOUT_MS=4000
